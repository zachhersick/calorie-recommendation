# Copy to .env, fill in, then load it into your shell (for example `set -a; . ./.env; set +a`).

# Local development: enables a throwaway secret key and localhost hosts.
DJANGO_DEBUG=1

# Required whenever DJANGO_DEBUG is off. Generate one with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Comma-separated, required in production.
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=

# Production behind HTTPS.
DJANGO_SECURE_SSL_REDIRECT=0
DJANGO_SECURE_HSTS_SECONDS=0
